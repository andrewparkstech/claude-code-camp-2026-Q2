#!/usr/bin/env bash

set -euo pipefail

name="$1"
dir="$(dirname "$0")/ruby"
target="$dir/$name"

cat > "$target" <<EOF
#!/usr/bin/env bash

SCRIPT_DIR="\$(cd "\$(dirname "\$0")" && pwd)"
REPO_ROOT="\$(cd "\$SCRIPT_DIR/../../.." && pwd)"

export BOUKENSHA_DIR="\$REPO_ROOT/.boukensha"

cd "\$SCRIPT_DIR/../../ruby/$name"
bundle exec ruby examples/example.rb
EOF

chmod +x "$target"
